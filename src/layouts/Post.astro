---
import CommentsPanel from "@/components/CommentsPanel.astro";
import { formatDate } from "@/lib/format";
import type { MarkdownTocItem } from "@/lib/security";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	publishedAt?: string;
	authorName?: string;
	categoryName?: string;
	articleSidebarAvatarPath?: string;
	articleSidebarName?: string;
	articleSidebarBadge?: string;
	articleSidebarBio?: string;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	backgroundOverride?: {
		imageKey: string;
		opacity: number;
		blur: number;
		scale: number;
		positionX: number;
		positionY: number;
	};
	toc?: MarkdownTocItem[];
}

const {
	slug,
	title,
	description,
	image,
	canonicalUrl,
	publishedAt,
	authorName,
	categoryName,
	articleSidebarAvatarPath,
	articleSidebarName,
	articleSidebarBadge,
	articleSidebarBio,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	backgroundOverride,
	toc,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const sidebarName = articleSidebarName?.trim() || authorName?.trim() || "博主";
const sidebarBadge = articleSidebarBadge?.trim() || "文章作者";
const sidebarBio = articleSidebarBio?.trim() || "在这里记录技术、生活和折腾。";
const sidebarAvatarInitial = sidebarName.slice(0, 1).toUpperCase();
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}
if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}
const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;

// ⭐ 修改：处理目录树，用于 Story 风格的底部折叠目录
const tocEntries = (toc ?? [])
	.map((item) => ({
		...item,
		level:
			Number.isInteger(item.level) && item.level >= 2 && item.level <= 4
				? item.level
				: 2,
		text: item.text.trim(),
	}))
	.filter((item) => item.id && item.text);
const hasToc = tocEntries.length > 0;
---

<Base
	title={title}
	description={description}
	image={image}
	canonicalUrl={canonicalUrl}
	backgroundOverride={backgroundOverride}
>
	<article class="article-shell story-article">
		<!-- ⭐ 文章头部：标题、元信息 -->
		<header class="article-header">
			<h1 class="article-title">{title}</h1>
			{description && <p class="article-summary">{description}</p>}
			<div class="article-meta">
				{formattedDate && (
					<time class="meta-item" datetime={publishedAt}>
						📅 {formattedDate}
					</time>
				)}
				{authorName && <span class="meta-item">✍️ {authorName}</span>}
				{categoryName && <span class="meta-item">📂 {categoryName}</span>}
				<span class="meta-item">📖 {articleLengthLabel}</span>
				<span class="meta-item">⏱️ {articleReadingTimeLabel}</span>
			</div>
		</header>

		<!-- ⭐ 文章正文 -->
		<div class="article-body">
			<div class="prose article-prose">
				<slot />
			</div>
		</div>

		<!-- ⭐ Story 风格目录树（折叠在底部） -->
		{hasToc && (
			<div class="story-toc-wrapper">
				<button
					type="button"
					class="story-toc-toggle"
					id="storyTocToggle"
					aria-expanded="false"
				>
					📑 目录
				</button>
				<nav class="story-toc-panel" id="storyTocPanel" style="display: none;">
					<ol class="story-toc-list">
						{tocEntries.map((item) => (
							<li class={`story-toc-item level-${item.level}`}>
								<a href={`#${item.id}`} class="story-toc-link">
									{item.text}
								</a>
							</li>
						))}
					</ol>
				</nav>
			</div>
		)}

		<!-- ⭐ 评论 -->
		<div class="article-comments">
			<CommentsPanel />
		</div>

		<!-- ⭐ 底部导航（返回归档、回到顶部） -->
		<div class="article-footer-nav">
			<a href="/blog" class="nav-link">← 返回归档</a>
			<a href="#top" class="nav-link">↑ 回到顶部</a>
		</div>
	</article>

	<!-- ⭐ 目录切换脚本 -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			const toggle = document.getElementById('storyTocToggle');
			const panel = document.getElementById('storyTocPanel');
			if (toggle && panel) {
				toggle.addEventListener('click', function() {
					const isOpen = panel.style.display === 'block';
					panel.style.display = isOpen ? 'none' : 'block';
					toggle.setAttribute('aria-expanded', !isOpen);
				});
			}
		});
	</script>
</Base>

<style>
/* ⭐ Story 主题文章样式 */
.story-article {
	max-width: 820px;
	margin: 0 auto;
	padding: 2rem 0;
}

.article-header {
	margin-bottom: 2.5rem;
}

.article-title {
	font-size: clamp(2rem, 2.5vw, 3.2rem);
	line-height: 1.15;
	font-weight: 700;
	color: #1a1a1a;
	margin-bottom: 0.75rem;
}

.article-summary {
	font-size: 1.05rem;
	line-height: 1.7;
	color: #666;
	margin-bottom: 1.25rem;
}

.article-meta {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem 1.25rem;
	padding: 0.75rem 0;
	border-top: 1px solid #eaeef3;
	border-bottom: 1px solid #eaeef3;
}

.meta-item {
	font-size: 0.9rem;
	color: #888;
}

.article-body {
	margin-bottom: 2.5rem;
}

/* 文章正文排版 - 匹配 Story 风格 */
.article-prose {
	font-size: 1.05rem;
	line-height: 1.9;
	color: #2c3e50;
}

.article-prose :global(h2) {
	font-size: 1.6rem;
	margin-top: 2.2rem;
	margin-bottom: 0.8rem;
	font-weight: 600;
	color: #1a1a1a;
}

.article-prose :global(h3) {
	font-size: 1.3rem;
	margin-top: 1.8rem;
	margin-bottom: 0.6rem;
	font-weight: 600;
	color: #1a1a1a;
}

.article-prose :global(h4) {
	font-size: 1.1rem;
	margin-top: 1.4rem;
	margin-bottom: 0.5rem;
	font-weight: 600;
	color: #1a1a1a;
}

.article-prose :global(p) {
	margin-bottom: 1.25rem;
}

.article-prose :global(img) {
	max-width: 100%;
	border-radius: 8px;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.article-prose :global(blockquote) {
	border-left: 4px solid #3498db;
	padding-left: 1.2rem;
	color: #555;
	font-style: italic;
	margin: 1.5rem 0;
}

.article-prose :global(pre) {
	background: #f4f6f8;
	border-radius: 8px;
	padding: 1rem;
	overflow-x: auto;
	font-size: 0.9rem;
}

.article-prose :global(code) {
	background: #f0f2f4;
	padding: 0.1rem 0.4rem;
	border-radius: 4px;
	font-size: 0.9em;
}

/* Story 风格目录树（折叠） */
.story-toc-wrapper {
	margin: 2rem 0;
	border: 1px solid #eaeef3;
	border-radius: 8px;
	background: #fafbfc;
	overflow: hidden;
}

.story-toc-toggle {
	display: block;
	width: 100%;
	padding: 0.8rem 1.2rem;
	background: transparent;
	border: none;
	font-size: 1rem;
	font-weight: 500;
	color: #2c3e50;
	cursor: pointer;
	text-align: left;
	transition: background 0.2s;
}

.story-toc-toggle:hover {
	background: #f0f2f4;
}

.story-toc-panel {
	padding: 0.5rem 1.2rem 1.2rem;
}

.story-toc-list {
	list-style: none;
	margin: 0;
	padding: 0;
}

.story-toc-item {
	margin: 0.2rem 0;
}

.story-toc-item.level-3 {
	padding-left: 1.2rem;
}

.story-toc-item.level-4 {
	padding-left: 2.4rem;
}

.story-toc-link {
	color: #2c3e50;
	text-decoration: none;
	font-size: 0.95rem;
	line-height: 1.8;
	border-bottom: 1px solid transparent;
	transition: color 0.2s, border-color 0.2s;
}

.story-toc-link:hover {
	color: #3498db;
	border-bottom-color: #3498db;
}

/* 评论区域 */
.article-comments {
	margin-top: 2.5rem;
	padding-top: 2rem;
	border-top: 1px solid #eaeef3;
}

/* 底部导航 */
.article-footer-nav {
	display: flex;
	justify-content: space-between;
	margin-top: 2rem;
	padding-top: 1.5rem;
	border-top: 1px solid #eaeef3;
}

.nav-link {
	color: #888;
	text-decoration: none;
	font-size: 0.95rem;
	transition: color 0.2s;
}

.nav-link:hover {
	color: #3498db;
}

/* 响应式 */
@media (max-width: 768px) {
	.story-article {
		padding: 1rem 0;
	}
	.article-meta {
		flex-direction: column;
		gap: 0.3rem;
	}
	.article-title {
		font-size: 1.8rem;
	}
	.article-prose {
		font-size: 0.98rem;
	}
}
</style>