---
import { env } from "cloudflare:workers";
import { desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";

const page = Number(Astro.url.searchParams.get("page") || "1");
const limit = 10;
const offset = (page - 1) * limit;

interface ArchivePostRow {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}

let posts: ArchivePostRow[] = [];
let totalPosts = 0;

try {
	const db = getDb(env.DB);

	const [countResult] = await db
		.select({ count: sql<number>`count(*)` })
		.from(blogPosts)
		.where(getPublicPostVisibilityCondition());
	totalPosts = countResult?.count ?? 0;

	const rows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(getPublicPostVisibilityCondition())
		.orderBy(desc(blogPosts.publishedAt))
		.limit(limit)
		.offset(offset);
	posts = rows;
} catch {
	// D1 未绑定时回退为空列表
}

const totalPages = Math.ceil(totalPosts / limit);
const hasPosts = posts.length > 0;
---

<Base title="归档" description="按时间顺序浏览全部已发布文章">
	<div class="container-fluid">
		<div class="row">
			<div id="main" role="main">
				<ul class="post-list clearfix">
					{hasPosts ? (
						posts.map((post) => (
							<PostCard
								title={post.title}
								slug={post.slug}
								excerpt={post.excerpt}
								publishedAt={post.publishedAt}
								authorName={post.authorName}
								categoryName={post.categoryName}
								featuredImageKey={post.featuredImageKey}
								featuredImageAlt={post.featuredImageAlt}
							/>
						))
					) : (
						<li class="post-item grid-item">
							<a class="post-link">
								<h3 class="post-title">(´°̥̥̥̥̥̥̥̥ω°̥̥̥̥̥̥̥̥｀)<br />什么都没有找到唉...</h3>
							</a>
						</li>
					)}
				</ul>
			</div>
		</div>
	</div>

	<!-- ⭐ 分页 -->
	{totalPages > 1 && (
		<div class="container-fluid">
			<div class="row">
				<div class="nav-page">
					<ol class="page-navigator">
						{page > 1 && (
							<li class="prev"><a href={`/blog?page=${page - 1}`}>&laquo;</a></li>
						)}
						{Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
							<li class:list={[{ current: p === page }]}>
								<a href={`/blog?page=${p}`}>{p}</a>
							</li>
						))}
						{page < totalPages && (
							<li class="next"><a href={`/blog?page=${page + 1}`}>&raquo;</a></li>
						)}
					</ol>
				</div>
			</div>
		</div>
	)}
</Base>