---
import { env } from "cloudflare:workers";
import { and, asc, desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import {
  DEFAULT_SITE_APPEARANCE,
  getSiteAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
  title: string;
  slug: string;
  excerpt: string | null;
  publishedAt: string | null;
  authorName: string | null;
  categoryName: string | null;
  featuredImageKey: string | null;
  featuredImageAlt: string | null;
}

// ---------- 分页参数 ----------
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const limit = 4;
const offset = (currentPage - 1) * limit;

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let homepageAppearance = DEFAULT_SITE_APPEARANCE;
let totalPages = 0;

function toHomePostCardRow(row: {
  title: string;
  slug: string;
  content: string;
  excerpt: string | null;
  publishedAt: string | null;
  authorName: string | null;
  categoryName: string | null;
  featuredImageKey: string | null;
  featuredImageAlt: string | null;
}): HomePostCardRow {
  const readingStats = estimateArticleReadStats(row.content);
  return {
    title: row.title,
    slug: row.slug,
    excerpt: row.excerpt,
    publishedAt: row.publishedAt,
    authorName: row.authorName,
    categoryName: row.categoryName,
    featuredImageKey: row.featuredImageKey,
    featuredImageAlt: row.featuredImageAlt,
  };
}

try {
  const db = getDb(env.DB);
  homepageAppearance = await getSiteAppearance(db);

  // ---- 置顶文章（不分页） ----
  const pinnedRows = await db
    .select({
      title: blogPosts.title,
      slug: blogPosts.slug,
      content: blogPosts.content,
      excerpt: blogPosts.excerpt,
      publishedAt: blogPosts.publishedAt,
      authorName: blogPosts.authorName,
      categoryName: blogCategories.name,
      featuredImageKey: blogPosts.featuredImageKey,
      featuredImageAlt: blogPosts.featuredImageAlt,
    })
    .from(blogPosts)
    .leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
    .where(
      and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true))
    )
    .orderBy(
      asc(blogPosts.pinnedOrder),
      desc(blogPosts.publishedAt),
      desc(blogPosts.createdAt)
    )
    .limit(6);
  pinnedPosts = pinnedRows.map(toHomePostCardRow);

  // ---- 统计非置顶总数 ----
  const countResult = await db
    .select({ count: sql<number>`count(*)` })
    .from(blogPosts)
    .where(
      and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, false))
    );
  const totalNonPinned = countResult[0]?.count || 0;
  totalPages = Math.ceil(totalNonPinned / limit);

  // ---- 当前页的非置顶文章 ----
  const recentRows = await db
    .select({
      title: blogPosts.title,
      slug: blogPosts.slug,
      content: blogPosts.content,
      excerpt: blogPosts.excerpt,
      publishedAt: blogPosts.publishedAt,
      authorName: blogPosts.authorName,
      categoryName: blogCategories.name,
      featuredImageKey: blogPosts.featuredImageKey,
      featuredImageAlt: blogPosts.featuredImageAlt,
    })
    .from(blogPosts)
    .leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
    .where(
      and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, false))
    )
    .orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
    .limit(limit)
    .offset(offset);
  recentPosts = recentRows.map(toHomePostCardRow);
} catch {
  // D1 未绑定时降级为空
}

// ---- 页码重定向（防止超出范围） ----
if (totalPages > 0 && currentPage > totalPages) {
  return Astro.redirect(`/?page=${totalPages}`);
}

// ---- 生成分页导航数据（在模板外处理，避免模板内出现 if） ----
type PageItem = 
  | { type: 'ellipsis'; key: string }
  | { type: 'link' | 'current'; key: string; label: string; href: string };

let pageItems: PageItem[] = [];
if (totalPages > 1) {
  const range = 2;
  const pages: (number | 'ellipsis')[] = [];
  for (let i = 1; i <= totalPages; i++) {
    if (
      i === 1 ||
      i === totalPages ||
      (i >= currentPage - range && i <= currentPage + range)
    ) {
      pages.push(i);
    } else if (pages[pages.length - 1] !== 'ellipsis') {
      pages.push('ellipsis');
    }
  }

  pageItems = pages.map((p) => {
    if (p === 'ellipsis') {
      return { type: 'ellipsis', key: `ellipsis-${Date.now()}-${Math.random()}` };
    }
    const isCurrent = p === currentPage;
    return {
      type: isCurrent ? 'current' : 'link',
      key: `page-${p}`,
      label: String(p),
      href: `?page=${p}`,
    };
  });
}

const allPosts = [...pinnedPosts, ...recentPosts];
const hasPosts = allPosts.length > 0;
---

<Base title={siteConfig.name} description={siteConfig.description}>
  <!-- 文章列表 -->
  <div class="container-fluid">
    <div class="row">
      <div id="main" role="main">
        <ul class="post-list clearfix">
          {hasPosts ? (
            allPosts.map((post) => (
              <PostCard
                title={post.title}
                slug={post.slug}
                excerpt={post.excerpt}
                publishedAt={post.publishedAt}
                authorName={post.authorName}
                categoryName={post.categoryName}
                featuredImageKey={post.featuredImageKey}
                featuredImageAlt={post.featuredImageAlt}
              />
            ))
          ) : (
            <li class="post-item grid-item">
              <a class="post-link">
                <h3 class="post-title">还没有文章<br />去后台发布吧</h3>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>

  <!-- 分页导航（仅当总页数 > 1 时显示） -->
  {totalPages > 1 && (
    <div class="container-fluid">
      <div class="row">
        <div class="nav-page">
          <ol class="page-navigator">
            <!-- 上一页 -->
            {currentPage > 1 && (
              <li><a href={`?page=${currentPage - 1}`}>«</a></li>
            )}

            <!-- 页码 + 省略号（全部用三元表达式） -->
            {pageItems.map((item) =>
              item.type === 'ellipsis' ? (
                <li key={item.key}><span>…</span></li>
              ) : item.type === 'current' ? (
                <li key={item.key} class="current">
                  <a href={item.href}>{item.label}</a>
                </li>
              ) : (
                <li key={item.key}>
                  <a href={item.href}>{item.label}</a>
                </li>
              )
            )}

            <!-- 下一页 -->
            {currentPage < totalPages && (
              <li><a href={`?page=${currentPage + 1}`}>»</a></li>
            )}
          </ol>
        </div>
      </div>
    </div>
  )}
</Base>