---
import { env } from "cloudflare:workers";
import { and, asc, desc, eq } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import {
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let homepageAppearance = DEFAULT_SITE_APPEARANCE;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	homepageAppearance = await getSiteAppearance(db);

	const pinnedRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(
			and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)),
		)
		.orderBy(
			asc(blogPosts.pinnedOrder),
			desc(blogPosts.publishedAt),
			desc(blogPosts.createdAt),
		)
		.limit(6);
	pinnedPosts = pinnedRows.map(toHomePostCardRow);

	const recentRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(
			and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, false)),
		)
		.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
		.limit(6);
	recentPosts = recentRows.map(toHomePostCardRow);
} catch {
	// D1 未绑定时首页退化为空列表
}

const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);

// ⭐ 合并所有文章用于展示（置顶优先）
const allPosts = [...pinnedPosts, ...recentPosts];
const hasPosts = allPosts.length > 0;
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<!-- ⭐ Story 风格：简洁的首页头部 -->
	<section class="home-header">
		<h1 class="site-title">{siteConfig.name}</h1>
		<p class="site-description">{homepageMetaDescription}</p>
		<div class="header-actions">
			<a href="/blog" class="btn-primary">📖 浏览归档</a>
			<a href="/search" class="btn-secondary">🔍 搜索文章</a>
		</div>
	</section>

	<!-- ⭐ 文章列表 -->
	{hasPosts ? (
		<div class="home-grid">
			{allPosts.map((post, index) => (
				<PostCard
					title={post.title}
					slug={post.slug}
					excerpt={post.excerpt}
					publishedAt={post.publishedAt}
					authorName={post.authorName}
					categoryName={post.categoryName}
					featuredImageKey={post.featuredImageKey}
					featuredImageAlt={post.featuredImageAlt}
					cjkCharCount={post.cjkCharCount}
					latinWordCount={post.latinWordCount}
					estimatedReadingMinutes={post.estimatedReadingMinutes}
					coverSide={index % 2 === 0 ? "left" : "right"}
				/>
			))}
		</div>
	) : (
		<div class="empty-state">
			<p>📭 还没有已发布文章，去后台发布第一篇吧。</p>
		</div>
	)}

	<!-- ⭐ 底部：查看更多 -->
	{hasPosts && (
		<div class="view-all">
			<a href="/blog" class="btn-primary">查看全部文章 →</a>
		</div>
	)}
</Base>

<style>
	/* ⭐ Story 风格首页：简洁、干净、白底 */
	.home-header {
		padding: 2.5rem 0 2rem;
		text-align: center;
		border-bottom: 1px solid #eaeef3;
		margin-bottom: 2rem;
	}

	.site-title {
		font-size: clamp(2.2rem, 4vw, 3.6rem);
		font-weight: 700;
		color: #1a1a1a;
		margin: 0 0 0.5rem;
		letter-spacing: -0.03em;
	}

	.site-description {
		font-size: 1.1rem;
		color: #888;
		margin: 0 0 1.2rem;
		line-height: 1.6;
		max-width: 520px;
		margin-left: auto;
		margin-right: auto;
	}

	.header-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
	}

	.btn-primary,
	.btn-secondary {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 1.4rem;
		border-radius: 6px;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background 0.2s, border-color 0.2s, transform 0.2s;
	}

	.btn-primary {
		background: #3498db;
		color: #ffffff;
		border: 1px solid #3498db;
	}

	.btn-primary:hover {
		background: #2980b9;
		border-color: #2980b9;
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: #ffffff;
		color: #2c3e50;
		border: 1px solid #eaeef3;
	}

	.btn-secondary:hover {
		border-color: #3498db;
		background: #f0f7fc;
		transform: translateY(-2px);
	}

	/* ⭐ 文章网格 */
	.home-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	/* ⭐ 空状态 */
	.empty-state {
		padding: 4rem 2rem;
		text-align: center;
		color: #999;
		font-size: 1.05rem;
		background: #fafbfc;
		border-radius: 8px;
		border: 1px solid #eaeef3;
	}

	/* ⭐ 查看全部 */
	.view-all {
		text-align: center;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid #eaeef3;
	}

	.view-all .btn-primary {
		font-size: 1rem;
		padding: 0.7rem 2rem;
	}

	/* ⭐ 响应式 */
	@media (max-width: 640px) {
		.home-header {
			padding: 1.5rem 0 1.2rem;
		}

		.site-title {
			font-size: 1.8rem;
		}

		.site-description {
			font-size: 0.95rem;
		}

		.home-grid {
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			gap: 1rem;
		}

		.btn-primary,
		.btn-secondary {
			padding: 0.5rem 1rem;
			font-size: 0.9rem;
		}
	}
</style>