---
import { env } from "cloudflare:workers";
import SearchBox from "@/components/Search.astro";
import { blogCategories, blogTags } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { sanitizeSlug } from "@/lib/security";

function normalizeDateInput(value: string | null) {
	if (!value) {
		return "";
	}
	const normalized = value.trim();
	if (!/^\d{4}-\d{2}-\d{2}$/u.test(normalized)) {
		return "";
	}
	const parsed = new Date(`${normalized}T00:00:00`);
	if (Number.isNaN(parsed.getTime())) {
		return "";
	}
	const [year, month, day] = normalized.split("-").map((item) => Number(item));
	if (
		parsed.getFullYear() !== year ||
		parsed.getMonth() + 1 !== month ||
		parsed.getDate() !== day
	) {
		return "";
	}
	return normalized;
}

const query = Astro.url.searchParams.get("q")?.trim() || "";
const rawSelectedCategory =
	Astro.url.searchParams.get("category")?.trim().toLowerCase() || "";
const selectedCategory = sanitizeSlug(rawSelectedCategory) || "";
const selectedTags = [
	...new Set(
		Astro.url.searchParams
			.getAll("tags")
			.map((item) => sanitizeSlug(item))
			.filter((item): item is string => Boolean(item)),
	),
];
const selectedDateFrom = normalizeDateInput(
	Astro.url.searchParams.get("dateFrom"),
);
const selectedDateTo = normalizeDateInput(Astro.url.searchParams.get("dateTo"));

const hasSearchCriteria = Boolean(
	query ||
		selectedCategory ||
		selectedTags.length > 0 ||
		selectedDateFrom ||
		selectedDateTo,
);

let categories: Array<{ slug: string; name: string }> = [];
let tags: Array<{ slug: string; name: string }> = [];

try {
	const db = getDb(env.DB);
	const [allCategories, allTags] = await Promise.all([
		db
			.select({ slug: blogCategories.slug, name: blogCategories.name })
			.from(blogCategories)
			.orderBy(blogCategories.name),
		db
			.select({ slug: blogTags.slug, name: blogTags.name })
			.from(blogTags)
			.orderBy(blogTags.name),
	]);
	categories = allCategories;
	tags = allTags;
} catch {
	// D1 未绑定时回退为空选项
}

const activeFilters = [
	query ? `关键词：${query}` : "",
	selectedCategory ? `分类：${selectedCategory}` : "",
	selectedTags.length > 0 ? `标签：${selectedTags.join("、")}` : "",
	selectedDateFrom || selectedDateTo
		? `时间：${selectedDateFrom || "不限"} 至 ${selectedDateTo || "不限"}`
		: "",
].filter(Boolean);
---

<Base title="搜索" description="使用 Pagefind 在浏览器本地检索文章内容">
	<!-- ⭐ Story 风格：简洁的搜索页面 -->
	<section class="search-header">
		<h1 class="page-title">🔍 搜索</h1>
		<p class="page-description">
			在浏览器本地搜索文章内容，支持关键词、分类、标签和时间筛选
		</p>
	</section>

	<!-- ⭐ 搜索框区域（SearchBox 组件，已适配 Story 样式） -->
	<div class="search-box-wrapper">
		<SearchBox
			initialQuery={query}
			categories={categories}
			tags={tags}
			selectedCategory={selectedCategory}
			selectedTags={selectedTags}
			selectedDateFrom={selectedDateFrom}
			selectedDateTo={selectedDateTo}
		/>
	</div>

	<!-- ⭐ 搜索结果 -->
	<section
		class="search-results-block"
		id="search-results-section"
		style={hasSearchCriteria ? undefined : "display:none"}
	>
		<div class="results-header">
			<h2 class="results-title">📄 搜索结果</h2>
			{activeFilters.length > 0 && (
				<p class="results-filters">
					{activeFilters.join(" · ")}
				</p>
			)}
			<p id="pagefind-results-summary" class="results-summary">
				{hasSearchCriteria ? "正在加载搜索结果..." : "输入关键词或筛选条件后开始搜索"}
			</p>
		</div>
		<div id="pagefind-search-results" class="results-grid" />
	</section>

	<script is:inline type="module" src="/pagefind-search.js"></script>
</Base>

<style>
	/* ⭐ Story 风格：简洁干净 */
	.search-header {
		padding: 1.5rem 0 1.2rem;
		border-bottom: 1px solid #eaeef3;
		margin-bottom: 1.8rem;
	}

	.page-title {
		font-size: 2rem;
		font-weight: 700;
		color: #1a1a1a;
		margin: 0 0 0.3rem;
	}

	.page-description {
		font-size: 1rem;
		color: #888;
		margin: 0;
		line-height: 1.6;
	}

	/* 搜索框容器 */
	.search-box-wrapper {
		margin-bottom: 2rem;
	}

	/* 搜索结果 */
	.search-results-block {
		display: grid;
		gap: 1rem;
	}

	.results-header {
		padding: 0.8rem 0 0.4rem;
		border-top: 1px solid #eaeef3;
	}

	.results-title {
		font-size: 1.2rem;
		font-weight: 600;
		color: #2c3e50;
		margin: 0 0 0.2rem;
	}

	.results-filters {
		font-size: 0.9rem;
		color: #888;
		margin: 0 0 0.2rem;
	}

	.results-summary {
		font-size: 0.9rem;
		color: #aaa;
		margin: 0;
	}

	.results-grid {
		display: grid;
		gap: 1rem;
	}

	/* ⭐ 响应式 */
	@media (max-width: 640px) {
		.search-header {
			padding: 1rem 0 0.8rem;
		}
		.page-title {
			font-size: 1.6rem;
		}
		.page-description {
			font-size: 0.9rem;
		}
		.results-title {
			font-size: 1rem;
		}
	}
</style>