---
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";
import { siteConfig } from "@/lib/types";

interface Props {
	title: string;
	slug: string;
	excerpt?: string | null;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	coverSide?: "left" | "right";
}

const {
	title,
	slug,
	excerpt,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	coverSide = "left",
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const encodedSlug = encodeRouteParam(slug);
---

<article class="post-card">
	<a href={`/blog/${encodedSlug}`} class="post-card-link" data-astro-prefetch="hover">
		{hasCover ? (
			<div class="post-card-cover">
				<img src={coverImageUrl} alt={coverImageAlt} loading="lazy" decoding="async" />
				<div class="post-card-overlay">
					<h2 class="post-card-title">{title}</h2>
					<div class="post-card-meta">
						{formattedDate && (
							<time class="post-card-date" datetime={publishedAt ?? undefined}>
								{formattedDate}
							</time>
						)}
						{categoryName && <span class="post-card-category">{categoryName}</span>}
					</div>
				</div>
			</div>
		) : (
			<div class="post-card-no-cover">
				<h2 class="post-card-title">{title}</h2>
				<div class="post-card-meta">
					{formattedDate && (
						<time class="post-card-date" datetime={publishedAt ?? undefined}>
							{formattedDate}
						</time>
					)}
					{categoryName && <span class="post-card-category">{categoryName}</span>}
				</div>
			</div>
		)}
	</a>
</article>

<style>
	/* ⭐ Story 风格卡片：正方形网格 */
	.post-card {
		position: relative;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border-radius: 8px;
		background: #ffffff;
		border: 1px solid #eaeef3;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
	}

	.post-card-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.post-card-cover {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.post-card-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.post-card:hover .post-card-cover img {
		transform: scale(1.05);
	}

	.post-card-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 1.5rem 1.2rem 1.2rem;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, 0.75));
		color: #ffffff;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 50%;
	}

	.post-card-title {
		font-size: clamp(1rem, 1.2vw, 1.3rem);
		font-weight: 600;
		margin: 0 0 0.4rem;
		line-height: 1.3;
		color: inherit;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.8rem;
		font-size: 0.8rem;
		opacity: 0.85;
	}

	.post-card-date,
	.post-card-category {
		display: inline-block;
	}

	/* 无封面图时的样式 */
	.post-card-no-cover {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		width: 100%;
		height: 100%;
		padding: 1.5rem;
		background: #fafbfc;
		color: #2c3e50;
	}

	.post-card-no-cover .post-card-title {
		color: #1a1a1a;
		margin-bottom: 0.5rem;
	}

	.post-card-no-cover .post-card-meta {
		color: #999;
	}

	/* 响应式 */
	@media (max-width: 640px) {
		.post-card-title {
			font-size: 1rem;
		}
		.post-card-overlay {
			padding: 1rem 0.8rem 0.8rem;
		}
	}
</style>