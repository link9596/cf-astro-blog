---
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";

interface Props {
	title: string;
	slug: string;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
}

const {
	title,
	slug,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const encodedSlug = encodeRouteParam(slug);
const displayCategory = categoryName || "未分类";
---

<article class="post-item grid-item" itemscope itemtype="http://schema.org/BlogPosting">
	<a class="post-link" href={`/blog/${encodedSlug}`} data-astro-prefetch="hover">
		<!-- 封面图 -->
		{hasCover ? (
			<span 
				class="cover" 
				style={`background: url(${coverImageUrl}) center/cover no-repeat;`}
			></span>
		) : (
			<span class="cover cover-placeholder"></span>
		)}
		
		<!-- ⭐ 左上角：分类标签（紧贴边角，无圆角） -->
		<div class="post-category-tag">{displayCategory}</div>
		
		<!-- ⭐ 右下角：信息卡（无圆角无边框，日期在上标题在下） -->
		<div class="post-info-card">
			{formattedDate && (
				<time class="post-date" datetime={publishedAt ?? undefined}>
					{formattedDate}
				</time>
			)}
			<h3 class="post-title">{title}</h3>
		</div>
	</a>
</article>

<style is:global>
	/* ⭐ 正方形卡片容器 - 3px 灰色边框，无圆角，无动画 */
	.post-item {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
		overflow: hidden;
		border: 3px solid #d0d5da;
		border-radius: 0;
		background: #f5f6f8;
		transition: border-color 0.25s ease;
	}

	/* ⭐ 悬浮时边框变 #FF7575，无其他动画 */
	.post-item:hover {
		border-color: #FF7575;
	}

	.post-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	/* ⭐ 封面图 - 铺满 */
	.cover {
		display: block;
		width: 100%;
		height: 100%;
		background: #e8ecf0 center/cover no-repeat;
	}

	.cover-placeholder {
		background: linear-gradient(135deg, #e8ecf0 25%, #d5dae0 50%, #e8ecf0 75%);
		background-size: 200% 200%;
		animation: shimmer 1.8s ease-in-out infinite;
	}

	@keyframes shimmer {
		0% { background-position: 0% 0%; }
		100% { background-position: 100% 100%; }
	}

	/* ⭐ 左上角分类标签 - 紧贴边角，无圆角 */
	.post-category-tag {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		padding: 4px 12px;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #4a4a4a;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid #d0d5da;
		border-radius: 0;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		white-space: nowrap;
		max-width: calc(100% - 8px);
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ⭐ 右下角信息卡 - 无圆角无边框，日期在上标题在下 */
	.post-info-card {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 2;
		padding: 8px 14px 10px;
		background: rgba(255, 255, 255, 0.72);
		backdrop-filter: blur(10px) saturate(140%);
		-webkit-backdrop-filter: blur(10px) saturate(140%);
		border: none;
		border-radius: 0;
	}

	/* 日期 - 在上方 */
	.post-date {
		display: block;
		font-size: 0.65rem;
		font-weight: 400;
		color: #8e95a3;
		letter-spacing: 0.02em;
		margin-bottom: 1px;
	}

	/* 标题 - 在下方，比分类标签大一点点 */
	.post-title {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.3;
		color: #1a1a1a;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}

	/* ⭐ 响应式 */
	@media (max-width: 640px) {
		.post-category-tag {
			padding: 3px 10px;
			font-size: 0.6rem;
		}
		.post-info-card {
			padding: 6px 10px 8px;
		}
		.post-date {
			font-size: 0.6rem;
		}
		.post-title {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.post-item {
			border-width: 2px;
		}
		.post-category-tag {
			padding: 2px 8px;
			font-size: 0.55rem;
		}
		.post-info-card {
			padding: 4px 8px 6px;
		}
		.post-date {
			font-size: 0.55rem;
		}
		.post-title {
			font-size: 0.72rem;
			-webkit-line-clamp: 2;
		}
	}
</style>