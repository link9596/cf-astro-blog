---
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";

interface Props {
	title: string;
	slug: string;
	excerpt?: string | null;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
}

const {
	title,
	slug,
	excerpt,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const encodedSlug = encodeRouteParam(slug);
const displayCategory = categoryName || authorName || "未分类";
---

<article class="post-item grid-item" itemscope itemtype="http://schema.org/BlogPosting">
	<a class="post-link" href={`/blog/${encodedSlug}`} data-astro-prefetch="hover">
		{hasCover && (
			<span 
				class="cover" 
				style={`background: url(${coverImageUrl}) center/cover no-repeat;`}
			></span>
		)}
		<h3 class="post-title">
			<time class="index-time" datetime={publishedAt ?? undefined}>
				{formattedDate || "日期待定"}
			</time>
			<br />
			{title}
		</h3>
		{displayCategory && (
			<div class="post-meta">{displayCategory}</div>
		)}
	</a>
</article>

<style is:global>
	/* 这些样式由 global.css 提供，不需要在这里重复定义 */
</style>