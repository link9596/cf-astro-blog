---
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";

interface Props {
	title: string;
	slug: string;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
}

const {
	title,
	slug,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const encodedSlug = encodeRouteParam(slug);
const displayCategory = categoryName || "未分类";
const displayAuthor = authorName || "";
---

<article class="post-item grid-item" itemscope itemtype="http://schema.org/BlogPosting">
	<a class="post-link" href={`/blog/${encodedSlug}`} data-astro-prefetch="hover">
		<!-- 封面图 -->
		{hasCover ? (
			<span 
				class="cover" 
				style={`background: url(${coverImageUrl}) center/cover no-repeat;`}
			></span>
		) : (
			<span class="cover cover-placeholder"></span>
		)}
		
		<!-- 左上角：分类标签（灰色边框同色矩形） -->
		<div class="post-category-tag">{displayCategory}</div>
		
		<!-- 右下角：毛玻璃信息卡 -->
		<div class="post-info-card">
			<h3 class="post-title">{title}</h3>
			{formattedDate && (
				<time class="post-date" datetime={publishedAt ?? undefined}>
					{formattedDate}
				</time>
			)}
			{displayAuthor && !categoryName && (
				<span class="post-author">{displayAuthor}</span>
			)}
		</div>
	</a>
</article>

<style is:global>
	/* ⭐ 正方形卡片容器 */
	.post-item {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
		overflow: hidden;
		border: 1px solid #d0d5da; /* 灰色边框 */
		border-radius: 6px;
		background: #f5f6f8;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.post-item:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
	}

	/* ⭐ 封面图 - 铺满整个卡片 */
	.post-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	.cover {
		display: block;
		width: 100%;
		height: 100%;
		background: #e8ecf0 center/cover no-repeat;
		transition: transform 0.4s ease;
	}

	.cover-placeholder {
		background: linear-gradient(135deg, #e8ecf0 25%, #d5dae0 50%, #e8ecf0 75%);
		background-size: 200% 200%;
		animation: shimmer 1.8s ease-in-out infinite;
	}

	@keyframes shimmer {
		0% { background-position: 0% 0%; }
		100% { background-position: 100% 100%; }
	}

	.post-item:hover .cover {
		transform: scale(1.04);
	}

	/* ⭐ 左上角：分类标签（灰色边框同色矩形） */
	.post-category-tag {
		position: absolute;
		top: 12px;
		left: 12px;
		z-index: 2;
		padding: 4px 14px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #6b7280;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid #d0d5da; /* 与卡片边框同色 */
		border-radius: 3px;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
		white-space: nowrap;
		max-width: calc(100% - 40px);
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ⭐ 右下角：毛玻璃信息卡 */
	.post-info-card {
		position: absolute;
		bottom: 14px;
		right: 14px;
		left: 14px;
		z-index: 2;
		padding: 10px 14px 12px;
		background: rgba(255, 255, 255, 0.68);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
		border: 1px solid rgba(255, 255, 255, 0.50);
		border-radius: 6px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
		transition: background 0.3s ease, transform 0.3s ease;
	}

	.post-item:hover .post-info-card {
		background: rgba(255, 255, 255, 0.82);
		transform: translateY(-2px);
	}

	/* 标题 */
	.post-title {
		margin: 0 0 2px 0;
		font-size: clamp(0.92rem, 1.1vw, 1.15rem);
		font-weight: 600;
		line-height: 1.3;
		color: #1a1a1a;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}

	/* 日期 */
	.post-date {
		display: block;
		font-size: 0.78rem;
		font-weight: 400;
		color: #8e95a3;
		letter-spacing: 0.02em;
		margin-top: 1px;
	}

	/* 作者（可选，仅当没有分类时显示） */
	.post-author {
		display: block;
		font-size: 0.72rem;
		color: #9aa1b0;
		margin-top: 1px;
	}

	/* ⭐ 响应式 */
	@media (max-width: 640px) {
		.post-category-tag {
			top: 8px;
			left: 8px;
			padding: 3px 10px;
			font-size: 0.65rem;
		}
		.post-info-card {
			bottom: 10px;
			right: 10px;
			left: 10px;
			padding: 8px 10px 10px;
		}
		.post-title {
			font-size: 0.85rem;
		}
		.post-date {
			font-size: 0.7rem;
		}
	}

	@media (max-width: 480px) {
		.post-info-card {
			bottom: 8px;
			right: 8px;
			left: 8px;
			padding: 6px 8px 8px;
			border-radius: 4px;
		}
		.post-title {
			font-size: 0.78rem;
			-webkit-line-clamp: 2;
		}
		.post-category-tag {
			top: 6px;
			left: 6px;
			padding: 2px 8px;
			font-size: 0.6rem;
		}
	}
</style>