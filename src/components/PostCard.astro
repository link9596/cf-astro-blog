---
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";

interface Props {
	title: string;
	slug: string;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
}

const {
	title,
	slug,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const encodedSlug = encodeRouteParam(slug);
const displayCategory = categoryName || "未分类";
---

<article class="post-item" itemscope itemtype="http://schema.org/BlogPosting">
	<a class="post-link" href={`/blog/${encodedSlug}`} data-astro-prefetch="hover">
		<!-- 封面图 -->
		<div class="cover-wrapper">
			{hasCover ? (
				<span 
					class="cover" 
					style={`background: url(${coverImageUrl}) center/cover no-repeat;`}
				></span>
			) : (
				<span class="cover cover-placeholder"></span>
			)}
		</div>
		
		<!-- 分类卡片 - 左上角 -->
		<div class="post-category-tag">{displayCategory}</div>
		
		<!-- 标题卡片 - 右下角，毛玻璃效果 -->
		<div class="post-info-card">
			{formattedDate && (
				<time class="post-date" datetime={publishedAt ?? undefined}>
					{formattedDate}
				</time>
			)}
			<h3 class="post-title">{title}</h3>
		</div>
	</a>
</article>

<style is:global>
	/* ⭐ 外面边框容器 - 正方形，4px #414141 边框，18px padding */
	.post-item {
		position: relative;
		display: block;
		word-break: break-word;
		overflow: hidden;
		width: 100%;
		height: 100%;
		aspect-ratio: 1 / 1;
		border: 4px solid #414141;
		padding: 18px;
		background: #ffffff;
		transition: border-color 0.24s ease;
	}

	/* ⭐ 悬浮时边框变 #FF7575 */
	.post-item:hover {
		border-color: #FF7575;
	}

	.post-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	/* ⭐ 封面图容器 - 填满 padding 内部 */
	.cover-wrapper {
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.cover {
		display: block;
		width: 100%;
		height: 100%;
		background: #e8ecf0 center/cover no-repeat;
	}

	.cover-placeholder {
		background: linear-gradient(135deg, #e8ecf0 25%, #d5dae0 50%, #e8ecf0 75%);
		background-size: 200% 200%;
		animation: shimmer 1.8s ease-in-out infinite;
	}

	@keyframes shimmer {
		0% { background-position: 0% 0%; }
		100% { background-position: 100% 100%; }
	}

	/* ⭐ 分类卡片 - 左上角，紧贴边角 */
	.post-category-tag {
		position: absolute;
		top: 0;
		left: 0;
		background: #414141;
		padding: 2px 14px 2px 10px;
		font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", STHeiti, "Microsoft Yahei", "WenQuanYi Micro Hei", Arial, Verdana, sans-serif;
		font-size: 14px;
		font-weight: 700;
		color: #ffffff;
		transition: background 0.24s ease, color 0.24s ease;
		z-index: 2;
		white-space: nowrap;
		max-width: calc(100% - 20px);
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ⭐ 悬浮时分类卡片背景也变 #FF7575 */
	.post-item:hover .post-category-tag {
		background: #FF7575;
	}

	/* ⭐ 标题卡片 - 右下角，毛玻璃效果，右对齐 */
	.post-info-card {
		position: absolute;
		bottom: 15px;
		right: 20px;
		padding-left: 50px;
		text-align: right;
		font-size: 20px;
		font-weight: 500;
		transition: all 0.24s ease;
		background-color: rgba(255, 255, 255, 0.42);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		backdrop-filter: saturate(180%) blur(20px);
		will-change: transform;
		transform: translateZ(0);
		transform: translate3d(0, 0, 0);
		z-index: 2;
		max-width: calc(100% - 40px);
	}

	/* 日期 - 上方 */
	.post-date {
		display: block;
		font-size: 0.7rem;
		font-weight: 400;
		color: #6b7280;
		letter-spacing: 0.02em;
		margin-bottom: 1px;
		line-height: 1.4;
	}

	/* 标题 - 下方，继承父级字体大小 */
	.post-title {
		margin: 0;
		font-size: inherit;
		font-weight: 500;
		line-height: 1.2;
		color: #1a1a1a;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}

	/* ⭐ 响应式适配 */
	@media (max-width: 768px) {
		.post-item {
			padding: 12px;
			border-width: 3px;
		}
		.post-category-tag {
			font-size: 12px;
			padding: 2px 10px 2px 8px;
		}
		.post-info-card {
			bottom: 10px;
			right: 12px;
			padding-left: 30px;
			font-size: 16px;
		}
		.post-date {
			font-size: 0.6rem;
		}
	}

	@media (max-width: 480px) {
		.post-item {
			padding: 8px;
			border-width: 2px;
		}
		.post-category-tag {
			font-size: 10px;
			padding: 1px 8px 1px 6px;
		}
		.post-info-card {
			bottom: 8px;
			right: 8px;
			padding-left: 20px;
			font-size: 13px;
		}
		.post-date {
			font-size: 0.55rem;
		}
	}
</style>