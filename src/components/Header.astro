---
import { siteConfig } from "@/lib/types";
---

<style>
  .site-header {
    padding: 20px 30px 30px 30px;
    background: transparent;
    position: relative; /* 为下拉面板定位 */
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ---------- 方块导航 ---------- */
  .logo-block {
    display: flex;
    align-items: center;
    gap: 0; /* 无间距 */
  }

  .block-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    background-color: #414141;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Georgia', serif;
    text-decoration: none;
    transition: background 0.2s, opacity 0.2s;
    cursor: default;
    user-select: none;
  }

  .block-item.brand-link {
    cursor: pointer;
  }

  .block-item.brand-link:hover {
    background-color: #3498db; /* 悬停高亮，可自定义 */
  }

  /* 第六个方块 - 汉堡菜单按钮 */
  .block-item.menu-toggle {
    cursor: pointer;
    background-color: #414141;
    font-size: 18px;
    font-weight: 400;
  }

  .block-item.menu-toggle:hover {
    background-color: #555;
  }

  /* 右侧占位（保持布局） */
  .header-right {
    flex: 0 0 auto;
  }

  /* ---------- 展开面板（右侧滑动/下拉） ---------- */
  .menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    min-width: 200px;
    background: #ffffff;
    border: 1px solid #eaeef3;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    padding: 1rem;
    z-index: 100;
    display: none; /* 默认隐藏 */
    transition: opacity 0.2s ease;
  }

  .menu-panel.open {
    display: block;
  }

  .menu-panel nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .menu-panel nav a {
    color: #2c3e50;
    text-decoration: none;
    font-size: 0.92rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid #f0f2f4;
    transition: color 0.2s;
  }

  .menu-panel nav a:hover {
    color: #3498db;
  }

  .menu-panel .search-box {
    width: 100%;
  }

  .menu-panel .search-box input {
    width: 100%;
    padding: 0.5rem 0.8rem;
    border: 1px solid #eaeef3;
    border-radius: 6px;
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .menu-panel .search-box input:focus {
    border-color: #3498db;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .block-item {
      width: 24px;
      height: 22px;
      font-size: 12px;
    }
    .block-item.menu-toggle {
      font-size: 16px;
    }
  }
</style>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- 方块导航 -->
      <div class="logo-block">
        <!-- F -->
        <span class="block-item">F</span>
        <!-- I -->
        <span class="block-item">I</span>
        <!-- L (链接) -->
        <a href="/" class="block-item brand-link">L</a>
        <!-- M -->
        <span class="block-item">M</span>
        <!-- s -->
        <span class="block-item">s</span>
        <!-- ≡ 汉堡 -->
        <span class="block-item menu-toggle" id="menuToggle">≡</span>
      </div>

      <!-- 右侧占位（保持原布局） -->
      <div class="header-right"></div>
    </div>

    <!-- 展开面板（包含导航菜单和搜索） -->
    <div id="menuPanel" class="menu-panel">
      <nav>
        <a href="/blog">归档</a>
        <a href="/about">关于</a>
        <!-- 可添加更多页面 -->
      </nav>
      <div class="search-box">
        <form action="/search" method="get" role="search">
          <input type="text" name="q" placeholder="搜索~" autocomplete="off" />
        </form>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('menuToggle');
    const panel = document.getElementById('menuPanel');

    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', function (e) {
        e.preventDefault();
        panel.classList.toggle('open');
      });

      // 点击面板外部关闭
      document.addEventListener('click', function (e) {
        if (
          !toggleBtn.contains(e.target) &&
          !panel.contains(e.target)
        ) {
          panel.classList.remove('open');
        }
      });
    }
  });
</script>