---
import { siteConfig } from "@/lib/types";
---

<style>
  .site-header {
    padding: 30px;
    background: transparent;
    position: relative;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ---------- 方块导航容器 ---------- */
  .logo-block {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
  }

  /* 每个方块统一样式 */
  .block-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    background-color: #414141;
    color: #fff;
    font-size: 14px;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Georgia', serif;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    user-select: none;
    cursor: default;
    flex-shrink: 0;
    padding-top: 0.25em;
  }

  /* L 特殊：默认白色背景，深色文字 */
  .block-item.brand-link {
    background-color: #fff;
    color: #414141;
    cursor: pointer;
  }
  .block-item.brand-link:hover {
    background-color: #414141;
    color: #fff;
  }

  .block-item.menu-toggle {
    cursor: pointer;
    font-size: 18px;
    font-weight: 400;
  }
  .block-item.menu-toggle:hover {
    background-color: #555;
  }

  /* ---------- 额外方块：动画显隐 ---------- */
  .block-item.extra {
    display: flex;              /* 始终 flex，通过 width/opacity 控制显隐 */
    width: 0;
    opacity: 0;
    overflow: hidden;          /* 隐藏溢出的文字 */
    transition: width 0.3s ease, opacity 0.3s ease;
    cursor: pointer;
    font-size: 16px;
    flex-shrink: 0;
  }
  .block-item.extra.visible {
    width: 28px;
    opacity: 1;
  }
  .block-item.extra:hover {
    background-color: #555;
  }

  /* ---------- 下方弹出容器 ---------- */
  .dropdown-block {
    display: block;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
    opacity: 0;
    background: transparent;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    min-width: 100%;
  }
  .dropdown-block.open {
    max-height: 300px;
    opacity: 1;
  }

  /* 下拉项（链接或输入框） */
  .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    background-color: #414141;
    color: #fff;
    padding: 0 12px;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
    border: none;
    width: 100%;
    box-sizing: border-box;
  }
  .dropdown-item:hover {
    background-color: #555;
  }
  .dropdown-item.search-input {
    width: 80px;
    padding: 0 8px;
    text-align: left;
    color: #fff;
    background-color: #414141;
    outline: none;
  }
  .dropdown-item.search-input::placeholder {
    color: #aaa;
  }

  /* 每个方块与其下拉容器配对，相对定位 */
  .block-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .site-header {
      padding: 30px 16px 30px 16px;
    }
  }
</style>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- 左侧方块组 -->
      <div class="logo-block">
        <!-- F -->
        <span class="block-item">F</span>
        <!-- I -->
        <span class="block-item">I</span>
        <!-- L (链接) -->
        <a href="/" class="block-item brand-link">L</a>
        <!-- M -->
        <span class="block-item">M</span>
        <!-- s -->
        <span class="block-item">s</span>
        <!-- ≡ 汉堡 -->
        <span class="block-item menu-toggle" id="menuToggle">≡</span>

        <!-- 额外方块：搜索 (🔍) -->
        <div class="block-wrapper" id="searchWrapper">
          <span class="block-item extra" id="searchBtn">🔍</span>
          <div class="dropdown-block" id="searchDropdown">
            <input type="text" class="dropdown-item search-input" placeholder="搜索~" />
          </div>
        </div>

        <!-- 额外方块：页面菜单 (🌳) -->
        <div class="block-wrapper" id="treeWrapper">
          <span class="block-item extra" id="treeBtn">🌳</span>
          <div class="dropdown-block" id="treeDropdown">
            <a href="/about" class="dropdown-item">关于</a>
            <a href="/blog" class="dropdown-item">归档</a>
            <a href="/contact" class="dropdown-item">联系</a>
          </div>
        </div>
      </div>

      <!-- 右侧占位 -->
      <div class="header-right"></div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('menuToggle');
    const searchBtn = document.getElementById('searchBtn');
    const treeBtn = document.getElementById('treeBtn');
    const searchDropdown = document.getElementById('searchDropdown');
    const treeDropdown = document.getElementById('treeDropdown');

    let extrasVisible = false;

    toggleBtn.addEventListener('click', function (e) {
      e.preventDefault();
      extrasVisible = !extrasVisible;
      searchBtn.classList.toggle('visible', extrasVisible);
      treeBtn.classList.toggle('visible', extrasVisible);
      // 关闭下拉
      searchDropdown.classList.remove('open');
      treeDropdown.classList.remove('open');
    });

    searchBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      searchDropdown.classList.toggle('open');
      treeDropdown.classList.remove('open');
    });

    treeBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      treeDropdown.classList.toggle('open');
      searchDropdown.classList.remove('open');
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.logo-block')) {
        searchDropdown.classList.remove('open');
        treeDropdown.classList.remove('open');
      }
    });
  });
</script>