---
import { siteConfig } from "@/lib/types";
---

<style>
  .site-header {
    padding: 20px 30px 30px 30px;
    background: transparent;
    position: relative;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ---------- 方块导航容器 ---------- */
  .logo-block {
    display: flex;
    align-items: center;
    gap: 0; /* 无间距 */
    flex-wrap: wrap;
  }

  /* 每个方块统一样式 */
  .block-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
    background-color: #414141;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Georgia', serif;
    text-decoration: none;
    transition: background 0.2s, opacity 0.2s;
    user-select: none;
    cursor: default;
  }

  .block-item.brand-link {
    cursor: pointer;
  }
  .block-item.brand-link:hover {
    background-color: #fff;
    color: #414141;
  }

  .block-item.menu-toggle {
    cursor: pointer;
    font-size: 18px;
    font-weight: 400;
  }
  .block-item.menu-toggle:hover {
    background-color: #555;
  }

  /* 隐藏的额外方块 */
  .block-item.extra {
    display: none;
    cursor: pointer;
    font-size: 16px;
  }
  .block-item.extra.visible {
    display: flex;
  }
  .block-item.extra:hover {
    background-color: #555;
  }

  /* ---------- 下方弹出容器 ---------- */
  .dropdown-block {
    display: none;          /* 默认隐藏 */
    flex-direction: column; /* 纵向排列子项 */
    align-items: stretch;
    background: transparent; /* 本身透明，子项自己背景 */
    gap: 0;                /* 无间距 */
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0;
    z-index: 10;
    min-width: 100%;        /* 与父容器同宽 */
  }
  .dropdown-block.open {
    display: flex;
  }

  /* 每个下拉项（链接或输入框） */
  .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    background-color: #414141;
    color: #fff;
    padding: 0 12px;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .dropdown-item:hover {
    background-color: #555;   /* 悬停变亮 */
  }
  /* 搜索输入框特殊处理 */
  .dropdown-item.search-input {
    background-color: #414141;
    border: none;
    outline: none;
    color: #fff;
    width: 80px;             /* 固定宽度 */
    padding: 0 8px;
    text-align: left;
  }
  .dropdown-item.search-input::placeholder {
    color: #aaa;
  }

  /* 每个方块与其下拉容器配对，相对定位 */
  .block-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
</style>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- 左侧方块组 -->
      <div class="logo-block">
        <!-- F -->
        <span class="block-item">F</span>
        <!-- I -->
        <span class="block-item">I</span>
        <!-- L (链接) -->
        <a href="/" class="block-item brand-link">L</a>
        <!-- M -->
        <span class="block-item">M</span>
        <!-- s -->
        <span class="block-item">s</span>
        <!-- ≡ 汉堡 -->
        <span class="block-item menu-toggle" id="menuToggle">≡</span>

        <!-- 额外方块：搜索 (🔍) -->
        <div class="block-wrapper" id="searchWrapper">
          <span class="block-item extra" id="searchBtn">🔍</span>
          <!-- 搜索框下拉 -->
          <div class="dropdown-block" id="searchDropdown">
            <input type="text" class="dropdown-item search-input" placeholder="搜索~" />
          </div>
        </div>

        <!-- 额外方块：页面菜单 (🌳) -->
        <div class="block-wrapper" id="treeWrapper">
          <span class="block-item extra" id="treeBtn">🌳</span>
          <!-- 页面链接下拉 -->
          <div class="dropdown-block" id="treeDropdown">
            <a href="/about" class="dropdown-item">关于</a>
            <a href="/blog" class="dropdown-item">归档</a>
            <a href="/contact" class="dropdown-item">联系</a>
            <!-- 可添加更多页面 -->
          </div>
        </div>
      </div>

      <!-- 右侧占位（保持原布局） -->
      <div class="header-right"></div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('menuToggle');
    const searchBtn = document.getElementById('searchBtn');
    const treeBtn = document.getElementById('treeBtn');
    const searchWrapper = document.getElementById('searchWrapper');
    const treeWrapper = document.getElementById('treeWrapper');
    const searchDropdown = document.getElementById('searchDropdown');
    const treeDropdown = document.getElementById('treeDropdown');

    let extrasVisible = false;

    // 点击 ≡ 切换显示额外方块
    toggleBtn.addEventListener('click', function (e) {
      e.preventDefault();
      extrasVisible = !extrasVisible;
      searchBtn.classList.toggle('visible', extrasVisible);
      treeBtn.classList.toggle('visible', extrasVisible);
      // 同时隐藏所有下拉
      searchDropdown.classList.remove('open');
      treeDropdown.classList.remove('open');
    });

    // 点击搜索方块切换搜索下拉
    searchBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      searchDropdown.classList.toggle('open');
      treeDropdown.classList.remove('open');
    });

    // 点击树形方块切换页面菜单下拉
    treeBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      treeDropdown.classList.toggle('open');
      searchDropdown.classList.remove('open');
    });

    // 点击页面其他区域关闭所有下拉
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.logo-block')) {
        searchDropdown.classList.remove('open');
        treeDropdown.classList.remove('open');
      }
    });
  });
</script>