---
interface TaxonomyOption {
	slug: string;
	name: string;
}

interface Props {
	initialQuery?: string;
	categories?: TaxonomyOption[];
	tags?: TaxonomyOption[];
	selectedCategory?: string;
	selectedTags?: string[];
	selectedDateFrom?: string;
	selectedDateTo?: string;
}

const {
	initialQuery = "",
	categories = [],
	tags = [],
	selectedCategory = "",
	selectedTags = [],
	selectedDateFrom = "",
	selectedDateTo = "",
}: Props = Astro.props;

const selectedTagSet = new Set(selectedTags);
const selectedTagItems = tags.filter((tag) => selectedTagSet.has(tag.slug));
const hasDateFilter = Boolean(selectedDateFrom || selectedDateTo);
const selectedDateLabel = hasDateFilter
	? `${selectedDateFrom || "不限"} 至 ${selectedDateTo || "不限"}`
	: "全部范围";
---

<div class="search-container">
	<form class="search-form" action="/search" method="get">
		<input
			type="search"
			name="q"
			class="search-input"
			placeholder="搜索文章标题、摘要或关键词"
			aria-label="搜索文章"
			autocomplete="off"
			value={initialQuery}
		/>
		{categories.length > 0 ? (
			<select name="category" class="search-select" aria-label="按分类筛选">
				<option value="">全部分类</option>
				{categories.map((category) => (
					<option value={category.slug} selected={selectedCategory === category.slug}>
						{category.name}
					</option>
				))}
			</select>
		) : null}
		<button type="submit" class="button search-button">搜索</button>

		<!-- 标签筛选和日期筛选保持不变，仅调整样式 -->
		{tags.length > 0 ? (
			<div class="search-tags-shell">
				<div class="search-tags-head">
					<span class="search-tags-head-label">🏷️ 标签筛选</span>
					{selectedTagItems.length > 0 ? (
						<div class="search-selected-tags" aria-live="polite">
							{selectedTagItems.map((tag) => (
								<span class="search-selected-chip">{tag.name}</span>
							))}
						</div>
					) : (
						<span class="search-selected-empty">未选择标签</span>
					)}
				</div>
				<details class="search-tags-panel">
					<summary>
						{selectedTagItems.length > 0
							? `调整标签（已选 ${selectedTagItems.length}）`
							: "展开选择标签"}
					</summary>
					<fieldset class="search-tags">
						<legend class="sr-only">按标签筛选</legend>
						<div class="search-tag-list">
							{tags.map((tag) => (
								<label class="search-tag-chip">
									<input
										type="checkbox"
										name="tags"
										value={tag.slug}
										checked={selectedTagSet.has(tag.slug)}
									/>
									<span>{tag.name}</span>
								</label>
							))}
						</div>
					</fieldset>
				</details>
			</div>
		) : null}

		<div class="search-date-shell">
			<div class="search-date-head">
				<span class="search-date-head-label">📅 时间范围</span>
				<span class="search-date-hint">{selectedDateLabel}</span>
			</div>
			<details class="search-date-panel">
				<summary>
					{hasDateFilter ? "调整时间范围（已设置）" : "展开选择时间范围"}
				</summary>
				<div class="search-date-body">
					<p class="search-date-tip">起止日期都可留空；不填即按全部范围搜索。</p>
					<div class="search-date-row">
						<label class="search-date-field">
							<span>从</span>
							<input
								type="date"
								name="dateFrom"
								class="search-date-input"
								aria-label="起始日期"
								value={selectedDateFrom}
							/>
						</label>
						<label class="search-date-field">
							<span>到</span>
							<input
								type="date"
								name="dateTo"
								class="search-date-input"
								aria-label="结束日期"
								value={selectedDateTo}
							/>
						</label>
					</div>
				</div>
			</details>
		</div>
	</form>
	<div id="search-results" class="search-results"></div>
</div>

<style>
	/* ⭐ Story 风格搜索 */
	.search-container {
		width: 100%;
		max-width: 46rem;
	}

	.search-form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 1.2rem;
		border-radius: 8px;
		background: #ffffff;
		border: 1px solid #eaeef3;
	}

	.search-input,
	.search-select,
	.search-date-input {
		flex: 1;
		min-width: min(100%, 12rem);
		padding: 0.75rem 1rem;
		border: 1px solid #eaeef3;
		border-radius: 6px;
		background: #fafbfc;
		color: #2c3e50;
		font-size: 0.95rem;
		font-family: inherit;
		transition: border-color 0.2s, background 0.2s;
	}

	.search-select {
		appearance: none;
	}

	.search-input::placeholder {
		color: #bbb;
	}

	.search-input:focus,
	.search-select:focus,
	.search-date-input:focus {
		outline: none;
		border-color: #3498db;
		background: #ffffff;
	}

	.search-button {
		padding: 0.75rem 1.5rem;
		border: none;
		border-radius: 6px;
		background: #3498db;
		color: #ffffff;
		font-size: 0.95rem;
		cursor: pointer;
		transition: background 0.2s;
	}

	.search-button:hover {
		background: #2980b9;
	}

	/* 标签和日期面板 - 简化样式 */
	.search-tags-shell,
	.search-date-shell {
		width: 100%;
		display: grid;
		gap: 0.4rem;
	}

	.search-tags-head,
	.search-date-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.search-tags-head-label,
	.search-date-head-label {
		font-size: 0.85rem;
		color: #888;
	}

	.search-selected-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		justify-content: flex-end;
	}

	.search-selected-chip {
		padding: 0.2rem 0.6rem;
		border-radius: 12px;
		border: 1px solid #3498db;
		background: #ebf5fb;
		font-size: 0.78rem;
		color: #2c3e50;
	}

	.search-selected-empty {
		font-size: 0.78rem;
		color: #bbb;
	}

	.search-tags-panel,
	.search-date-panel {
		border: 1px solid #eaeef3;
		border-radius: 8px;
		background: #fafbfc;
		overflow: hidden;
	}

	.search-tags-panel summary,
	.search-date-panel summary {
		list-style: none;
		cursor: pointer;
		padding: 0.6rem 0.8rem;
		font-size: 0.85rem;
		color: #888;
		display: flex;
		align-items: center;
		justify-content: space-between;
		user-select: none;
	}

	.search-tags-panel summary::-webkit-details-marker,
	.search-date-panel summary::-webkit-details-marker {
		display: none;
	}

	.search-tags-panel summary::after,
	.search-date-panel summary::after {
		content: "▾";
		font-size: 0.7rem;
		opacity: 0.7;
		transition: transform 0.2s;
	}

	.search-tags-panel[open] summary::after,
	.search-date-panel[open] summary::after {
		transform: rotate(180deg);
	}

	.search-tags-panel[open] summary,
	.search-date-panel[open] summary {
		border-bottom: 1px solid #eaeef3;
	}

	.search-tags {
		width: 100%;
		border: none;
		padding: 0.6rem 0.8rem 0.8rem;
		margin: 0;
		display: grid;
		gap: 0.4rem;
	}

	.search-tags legend {
		font-size: 0.82rem;
		color: #999;
	}

	.search-tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.search-tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem 0.6rem;
		border-radius: 12px;
		border: 1px solid #eaeef3;
		background: #ffffff;
		font-size: 0.8rem;
		color: #2c3e50;
		cursor: pointer;
		transition: border-color 0.2s, background 0.2s;
	}

	.search-tag-chip:hover {
		border-color: #3498db;
		background: #f0f7fc;
	}

	.search-tag-chip input {
		margin: 0;
	}

	.search-date-body {
		display: grid;
		gap: 0.5rem;
		padding: 0.6rem 0.8rem 0.8rem;
	}

	.search-date-tip {
		margin: 0;
		font-size: 0.8rem;
		color: #999;
	}

	.search-date-row {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.search-date-field {
		display: grid;
		gap: 0.3rem;
		flex: 1;
		min-width: min(100%, 10rem);
		font-size: 0.8rem;
		color: #999;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.search-results {
		margin-top: 1.2rem;
	}

	@media (max-width: 640px) {
		.search-form {
			flex-direction: column;
		}
		.search-button {
			width: 100%;
		}
	}
</style>